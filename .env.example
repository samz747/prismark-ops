# Copy to .env and fill in. Never commit .env.
APP_ENV=production
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DOMAIN=ops.prismark.co.tz
TRUSTED_HOSTS=ops.prismark.co.tz
COOKIE_SECURE=true

POSTGRES_USER=prismark
# Long random password, different from every other password
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=prismark
DATABASE_URL=postgresql+psycopg2://prismark:change-me-too@db:5432/prismark

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=10
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_LIMIT_PER_MIN=10
